# 本机临时测试专用非Secret配置。可复制为.env.demo-smoke.local；可选，不改根.env。
# 可选：API首选端口，默认18000；占用时总入口自动改用空闲端口，仅绑定127.0.0.1。
SMOKE_API_PORT=18000
# 可选：前端首选端口，默认15173；同上。
SMOKE_FRONTEND_PORT=15173
# 可选：容器启动/健康的总等待秒数，默认180；不含单独镜像构建时间。
SMOKE_WAIT_TIMEOUT_SECONDS=180
# 可选：镜像构建总超时秒数，默认900，避免首次安装依赖被180秒健康超时误杀。
SMOKE_BUILD_TIMEOUT_SECONDS=900
# 不在模板填数据库密码、owner或project：每次由入口生成，写入Git忽略的runtime/<run_id>/。
# Mock固定开启，向量维度保持384；分类脚本不得修改这些前提而不记录报告。
