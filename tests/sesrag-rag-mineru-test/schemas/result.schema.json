{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "run_id", "category", "lane", "cases"],
  "properties": {
    "schema_version": {"const": 1}, "run_id": {"type": "string"},
    "category": {"type": "string"}, "lane": {"enum": ["local", "real"]},
    "cases": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "title", "requirements", "test_points", "status", "duration_ms", "error_code", "expected", "actual", "phases", "evidence"],
      "properties": {
        "case_id": {"type": "string"}, "title": {"type": "string", "minLength": 1},
        "requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "test_points": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "status": {"enum": ["passed", "failed", "blocked", "not_run", "harness_error"]},
        "duration_ms": {"type": "number", "minimum": 0},
        "error_code": {"type": ["string", "null"]},
        "expected": {"type": "string", "minLength": 1}, "actual": {"type": "string", "minLength": 1},
        "phases": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
          "required": ["path", "sha256"], "properties": {
            "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }}}
      }
    }}
  }
}
