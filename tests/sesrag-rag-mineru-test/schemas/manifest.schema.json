{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "categories"],
  "properties": {
    "schema_version": {"const": 1},
    "categories": {"type": "array", "minItems": 15, "maxItems": 15, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["category", "lane", "status", "entrypoint", "cases", "timeout_seconds", "workers", "dependencies", "may_charge"],
      "properties": {
        "category": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$"},
        "lane": {"enum": ["local", "real"]}, "status": {"enum": ["planned", "ready"]},
        "entrypoint": {"type": "string", "pattern": "^specific_test_script/[a-z0-9-]+\\.(py|mjs)$"},
        "cases": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["case_id", "requirements", "test_points"], "properties": {
            "case_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,60}$"},
            "requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(RAG|NFR)-[0-9]{3}$"}},
            "test_points": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^TQ-RAG-[A-Z]+-[0-9]{3}$"}}
          }}},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "workers": {"type": "integer", "minimum": 1, "maximum": 2},
        "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "may_charge": {"type": "boolean"}
      }
    }}
  }
}
