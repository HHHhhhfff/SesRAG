ARG APP_IMAGE
FROM ${APP_IMAGE} AS application
FROM node:22.13.1-bookworm-slim AS node
FROM pgvector/pgvector:pg16 AS pgtools
FROM python:3.12-slim
USER root
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
WORKDIR /test-tools
COPY tests/sesrag-rag-mineru-test/package*.json ./
COPY tests/sesrag-rag-mineru-test/requirements-test.lock ./
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/test-browsers NODE_PATH=/test-tools/node_modules
# 某些本机网络对HTTP大索引不稳定；使用HTTPS且保持下载有界。
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && printf 'Acquire::Retries "2";\nAcquire::http::Timeout "30";\nAcquire::https::Timeout "30";\n' > /etc/apt/apt.conf.d/99test-download-bounds
RUN --mount=type=cache,id=sesrag-rag-test-npm,target=/root/.npm npm ci --no-audit --no-fund
RUN npx playwright install-deps chromium
COPY tests/sesrag-rag-mineru-test/helpers/download_browser.py /test-tools/download_browser.py
RUN --mount=type=cache,id=sesrag-rag-test-browsers,target=/cache/browsers \
    PLAYWRIGHT_BROWSERS_PATH=/cache/browsers python /test-tools/download_browser.py \
    && mkdir -p /opt/test-browsers \
    && cp -a /cache/browsers/chromium_headless_shell-* /cache/browsers/ffmpeg-* /opt/test-browsers/
# CMP_012在专属PG库实际执行dump/restore；独立于浏览器下载缓存层。
RUN apt-get update && apt-get install -y --no-install-recommends libpq5 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=pgtools /usr/lib/postgresql/16/bin/pg_dump /usr/local/bin/pg_dump
COPY --from=pgtools /usr/lib/postgresql/16/bin/pg_restore /usr/local/bin/pg_restore
RUN pg_dump --version | grep 'PostgreSQL) 16\.' && pg_restore --version | grep 'PostgreSQL) 16\.'
# 浏览器层独立于本轮app标签，重跑不因run/owner变化重复下载。
COPY --from=application /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=application /app /app
COPY --from=application /tmp/data-gym-cache /tmp/data-gym-cache
RUN --mount=type=cache,id=sesrag-rag-test-pip,target=/root/.cache/pip \
    pip install -r requirements-test.lock && pip check
# QLT_004后续需要真正的契约生成/类型/lint/build入口；工具源码与前端服务分开。
COPY contracts /app/contracts
COPY frontend/package*.json /app/frontend/
RUN --mount=type=cache,id=sesrag-rag-test-quality-npm,target=/root/.npm \
    cd /app/frontend && npm ci --no-audit --no-fund --maxsockets=5 \
    --fetch-retries=3 --fetch-timeout=120000
COPY frontend /app/frontend
WORKDIR /app
CMD ["python", "-c", "import time; time.sleep(86400)"]
