# 仅说明运行器生成字段；不能复制后直接启动。所有值由prepare_runtime生成。
# 必填：唯一run/project/owner、每project随机数据库密码、三类本轮镜像标签。
TEST_RUN_ID=generated-per-run
TEST_PROJECT=generated-per-category
TEST_OWNER=generated-ownership-token
TEST_OWNER_ID=rag-test-owner-a
TEST_PASSWORD=generated-never-commit
APP_IMAGE=generated-app-tag
FRONTEND_IMAGE=generated-frontend-tag
TOOLS_IMAGE=generated-tools-tag
# local仅dummy凭据；real值只来自明确runtime-inputs，默认不外发。
MINERU_ENABLED=false
MINERU_API_KEY=
MINERU_STATE_ENCRYPTION_KEY=
MINERU_STORAGE_HOST_ALLOWLIST=
RAG_EMBEDDING_API_KEY=
RAG_RERANK_API_KEY=
MODEL_API_KEY=
