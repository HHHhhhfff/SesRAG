# 仅作变量职责说明，不能代替总入口生成的 runtime/<run_id>/compose.env。
# 以下必填身份、路径和 tag 全由入口生成；不得手动借用开发 Compose 项目/数据卷。
WS_TEST_RUN_ID=
WS_TEST_OWNER_TOKEN=
WS_TEST_PROJECT=
WS_TEST_CATEGORY=env
WS_TEST_REPO_ROOT=
WS_TEST_TMP_DIR=
WS_TEST_APP_IMAGE=
WS_TEST_FRONTEND_IMAGE=
WS_TEST_TOOLS_IMAGE=
# 由入口对受测源码、工具和锁文件计算的 SHA256，用于构建/恢复核验，非秘密。
WS_TEST_SOURCE_DIGEST=
# 专属空数据库的固定非秘密身份；密码/DSN 必须由入口强随机生成，禁止提交。
WS_TEST_POSTGRES_DB=sesrag_workspace
WS_TEST_POSTGRES_USER=sesrag
WS_TEST_POSTGRES_PASSWORD=
WS_TEST_DATABASE_URL=
WS_TEST_REDIS_URL=redis://redis:6379/0
# 本地 Provider 的虚假模型 Key 与随机控制 token，仅写私有 runtime，不是外部服务凭据。
WS_TEST_MODEL_API_KEY=
WS_TEST_PROVIDER_CONTROL_TOKEN=
# 默认 0 让 Docker 选择动态回环端口，不可继承开发 8000/5173。
WS_TEST_API_PORT=0
WS_TEST_FRONTEND_PORT=0
WS_TEST_PROVIDER_CONTROL_PORT=0
# 仅workspace分类由入口设15秒，以稳定保持retry_waiting刷新窗口；其它分类默认2秒。
WS_TEST_RETRY_BASE_DELAY=2
