{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sesrag.local/schemas/category-result.schema.json",
  "title": "SesRAG product category result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "environment_id", "category", "started_at", "finished_at", "status", "cases", "evidence"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "pattern": "^ws-[0-9]{8}t[0-9]{6}z-[a-f0-9]{8}$" },
    "environment_id": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["passed", "failed", "blocked", "not_run", "harness_error"] },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "test_point_ids", "requirement_ids", "title", "type", "status", "expected", "actual", "reason_code", "reason", "evidence_paths", "duration_ms"],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "test_point_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "requirement_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "title": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "failed", "blocked", "not_run"] },
          "expected": { "type": "string", "minLength": 1 },
          "actual": { "type": "string", "minLength": 1 },
          "reason_code": { "type": ["string", "null"] },
          "reason": { "type": ["string", "null"] },
          "evidence_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "duration_ms": { "type": "number", "minimum": 0 }
        }
      }
    },
    "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
