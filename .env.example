# PostgreSQL 密码（Compose 必填；运行时注入，以下占位值必须替换，不提交真实凭据）
POSTGRES_PASSWORD=<replace-with-private-password>
# API/Worker/迁移使用的 PostgreSQL DSN（Compose 必填，密码 URL 编码后与上项一致）
DATABASE_URL=postgresql+psycopg://sesrag:<url-encoded-private-password>@postgres:5432/sesrag
# Redis 通知地址（可选；Redis 故障时系统退化为数据库轮询）
REDIS_URL=redis://redis:6379/0
# 是否启用 Redis 通知；离线单元测试可设为 false
REDIS_ENABLED=true
# 运行时上传目录，api 与 worker 必须共享该路径（必填）
UPLOAD_DIR=/data/uploads
# Demo 的固定开发 owner，不提供生产认证（开发默认值）
OWNER_ID=local-user
# Embedding 向量维度，Provider 返回值必须匹配（默认 384）
VECTOR_DIMENSION=384
# 调度参数：lease、心跳、重试、截止时间和轮询间隔
TASK_LEASE_TTL=30
TASK_HEARTBEAT_INTERVAL=10
TASK_MAX_ATTEMPTS=3
TASK_RETRY_BASE_DELAY=2
TASK_DEADLINE=600
WORKER_SHUTDOWN_GRACE=20
QUEUE_POLL_INTERVAL=1
SSE_POLL_INTERVAL=1
# 健康依赖探测和 Redis 操作超时，秒（可选，默认 2；必须为有限正值）
HEALTH_PROBE_TIMEOUT=2
# RAG 参数
RAG_TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# 使用 mock provider 进行无外部 Key 的本地验收；真实 Provider 接入时设为 false
MOCK_PROVIDER=true
MODEL_BASE_URL=
# 以上 URL 及以下三项在 MOCK_PROVIDER=false 时必填；默认空，Key 仅运行时注入，不落快照/日志。
MODEL_API_KEY=
MODEL_NAME=
EMBEDDING_MODEL_NAME=
# 前端浏览器HTTP/SSE/health共同base（可选，默认空=同源；仅无凭据HTTP(S)origin，不含Secret）
VITE_API_BASE_URL=
# Vite服务端代理目标（可选，宿主默认127.0.0.1:8000；Compose显式使用api:8000，不注入浏览器）
API_PROXY_TARGET=http://127.0.0.1:8000

