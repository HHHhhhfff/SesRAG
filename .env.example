# PostgreSQL 密码（Compose 必填；运行时注入，以下占位值必须替换，不提交真实凭据）
POSTGRES_PASSWORD=<replace-with-private-password>
# API/Worker/迁移使用的 PostgreSQL DSN（Compose 必填，密码 URL 编码后与上项一致）
DATABASE_URL=postgresql+psycopg://sesrag:<url-encoded-private-password>@postgres:5432/sesrag
# Redis 通知地址（可选；Redis 故障时系统退化为数据库轮询）
REDIS_URL=redis://redis:6379/0
# 是否启用 Redis 通知；离线单元测试可设为 false
REDIS_ENABLED=true
# 运行时上传目录，api 与 worker 必须共享该路径（必填）
UPLOAD_DIR=/data/uploads
# Demo 的固定开发 owner，不提供生产认证（开发默认值）
OWNER_ID=local-user
# legacy Embedding维度（默认384）；v3使用数据库EmbeddingProfile/Space，不能用本项改绑新空间。
VECTOR_DIMENSION=384
# 调度参数：lease、心跳、重试、截止时间和轮询间隔
TASK_LEASE_TTL=30
TASK_HEARTBEAT_INTERVAL=10
TASK_MAX_ATTEMPTS=3
TASK_RETRY_BASE_DELAY=2
TASK_DEADLINE=600
WORKER_SHUTDOWN_GRACE=20
QUEUE_POLL_INTERVAL=1
# SSE 观察轮询，秒（可选，默认 0.2；必须有限且大于 0）
SSE_POLL_INTERVAL=0.2
# 健康依赖探测和 Redis 操作超时，秒（可选，默认 2；必须为有限正值）
HEALTH_PROBE_TIMEOUT=2
# RAG 参数
RAG_TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# 旧配置的Provider开关；v3真实RAG仍须导入Profile并满足计数/凭据门槛，不由本开关自动启用。
MOCK_PROVIDER=true
MODEL_BASE_URL=
# 以上 URL 及以下三项在 MOCK_PROVIDER=false 时必填；默认空，Key 仅运行时注入，不落快照/日志。
MODEL_API_KEY=
MODEL_NAME=
EMBEDDING_MODEL_NAME=
# 前端浏览器HTTP/SSE/health共同base（可选，默认空=同源；仅无凭据HTTP(S)origin，不含Secret）
VITE_API_BASE_URL=
# Vite服务端代理目标（可选，宿主默认127.0.0.1:8000；Compose显式使用api:8000，不注入浏览器）
API_PROXY_TARGET=http://127.0.0.1:8000

# PRD-003：办公原件云端解析能力；默认关闭，不影响 txt/md 本地解析及服务启动。
MINERU_ENABLED=false
# 仅真实办公解析时必填，服务端使用；不得放入前端或报告。
MINERU_API_KEY=
# 仅真实办公解析时必填：32 字节随机值的 base64，API/Worker 必须一致；备份时单独保护。
MINERU_STATE_ENCRYPTION_KEY=
# 仅真实办公解析时必填：实际核实的签名存储域，逗号分隔；禁止通配符。
MINERU_STORAGE_HOST_ALLOWLIST=
# 两类真实模型独立配置，不能自动复用生成 Key；Mock 不需要。
RAG_EMBEDDING_API_KEY=
RAG_RERANK_API_KEY=
# 私有规范产物／临时目录，默认容器路径，不能静态公开。
RAG_ARTIFACT_DIR=/data/rag-artifacts
RAG_TMP_DIR=/data/rag-tmp
# 默认10GiB总软预算、1GiB临时预算；临时至少384MiB容纳一个槽位，不是宿主磁盘硬配额。
RAG_STORAGE_BUDGET_BYTES=10737418240
RAG_TMP_BUDGET_BYTES=1073741824
# 每 Worker 本轮流水线并发 1～4，默认 1；云端等待让出。
RAG_PIPELINE_CONCURRENCY=1
# 非空旧库升级必须显式指定非 Secret Profile 初始化文件；空库可初始化明确 Mock 模板。
RAG_BOOTSTRAP_CONFIG=
