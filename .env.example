# API 使用的 PostgreSQL DSN（必填，Compose 默认值可直接用于本地 Demo）
DATABASE_URL=postgresql+psycopg://sesrag:sesrag@postgres:5432/sesrag
# Redis 通知地址（可选；Redis 故障时系统退化为数据库轮询）
REDIS_URL=redis://redis:6379/0
# 是否启用 Redis 通知；离线单元测试可设为 false
REDIS_ENABLED=true
# 运行时上传目录，api 与 worker 必须共享该路径（必填）
UPLOAD_DIR=/data/uploads
# Demo 的固定开发 owner，不提供生产认证（开发默认值）
OWNER_ID=local-user
# Embedding 向量维度，Provider 返回值必须匹配（默认 384）
VECTOR_DIMENSION=384
# 调度参数：lease、心跳、重试、截止时间和轮询间隔
TASK_LEASE_TTL=30
TASK_HEARTBEAT_INTERVAL=10
TASK_MAX_ATTEMPTS=3
TASK_RETRY_BASE_DELAY=2
TASK_DEADLINE=600
WORKER_SHUTDOWN_GRACE=20
QUEUE_POLL_INTERVAL=1
SSE_POLL_INTERVAL=1
# RAG 参数
RAG_TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# 使用 mock provider 进行无外部 Key 的本地验收；真实 Provider 接入时设为 false
MOCK_PROVIDER=true
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
EMBEDDING_MODEL_NAME=

