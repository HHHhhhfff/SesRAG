{
  "name": "sesrag-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "generate:api": "node scripts/generate-api-types.mjs",
    "check:api": "node scripts/generate-api-types.mjs --check",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src scripts tests vite.config.ts vitest.config.ts eslint.config.mjs",
    "test:unit": "vitest run",
    "test:toolchain": "vitest run tests/toolchain.test.ts"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "lucide-vue-next": "^0.468.0",
    "marked": "^15.0.7",
    "pinia": "^2.3.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.11.1",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.72.0",
    "vite": "6.4.5",
    "vitest": "4.1.12",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "^2.2.0"
  }
}
