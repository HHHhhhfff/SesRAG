# 仅说明输入，不自动读取本文件或根.env；不要填写业务凭据。
# 必填身份，默认local；通过入口-EnvironmentId传入，1~32位小写字母/数字/短横线。
OBS_ENVIRONMENT_ID=local
# Prepare必填的显式部署描述；先由integration/export_binding.py核验实际容器后生成。
OBS_APPLICATION_CONTRACT=runtime/local/inputs/application-contract.json
# 可选，通过-GrafanaPort传入，默认3000，仅127.0.0.1。
OBS_GRAFANA_PORT=3000
# 可选，通过-HostOtlp启用，仅127.0.0.1:4318；默认不发布。
OBS_HOST_OTLP=false
# 其余OBS_OWNER/OBS_GENERATED/OBS_SECRET/OBS_APPLICATION_NETWORK/IMAGE_*由Prepare/Pull管理，
# 禁止手工覆盖或在父shell设置OBS_*/GF_*/IMAGE_*；Secret不写入monitoring.env。
# 平台来自接入描述；默认docker-desktop，原生linux-host才加载Node Exporter。
# 保留期和limits是版本化配置，修改须先备份/Stop，审核源码、重新Prepare并回归，不接受shell覆盖。
