{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "level": {
      "enum": [
        "INFO",
        "WARNING",
        "ERROR"
      ]
    },
    "service": {
      "enum": [
        "sesrag-api",
        "sesrag-worker"
      ]
    },
    "environment": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}$"
    },
    "action": {
      "type": "string",
      "maxLength": 64
    },
    "message": {
      "type": "string",
      "maxLength": 128
    },
    "trace_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?!0{32}$)[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "span_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?!0{16}$)[0-9a-f]{16}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "trace_sampled": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "origin_state": {
      "enum": [
        "present",
        "missing",
        "invalid",
        "disabled"
      ]
    },
    "thread_id": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "worker_id": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "document_id": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "index_batch_id": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "parse_job_id": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "retrieval_execution_id": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "stage": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "generation": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "attempt": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "duration_ms": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 86400000
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "timestamp",
    "level",
    "service",
    "environment",
    "action",
    "message",
    "trace_id",
    "span_id",
    "trace_sampled",
    "origin_state",
    "thread_id",
    "run_id",
    "task_id",
    "worker_id",
    "document_id",
    "index_batch_id",
    "parse_job_id",
    "retrieval_execution_id",
    "stage",
    "error_code",
    "generation",
    "attempt",
    "duration_ms"
  ],
  "additionalProperties": false
}
