{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "trace_id": {
      "type": "string",
      "pattern": "^(?!0{32}$)[0-9a-f]{32}$"
    },
    "span_id": {
      "type": "string",
      "pattern": "^(?!0{16}$)[0-9a-f]{16}$"
    },
    "sampled": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "trace_id",
    "span_id",
    "sampled"
  ],
  "additionalProperties": false
}
