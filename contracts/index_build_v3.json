  "required": [
    "index_batch_id",
    "document_id",
    "knowledge_base_id",
    "state",
    "stage",
    "task_id",
    "parse",
    "chunk_count",
    "error_code",
    "created_at"
  ],
  "title": "IndexBuild",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sesrag.local/contracts/index_build_v3.json"
}
