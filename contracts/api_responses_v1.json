{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sesrag.local/contracts/api_responses_v1.json",
  "$defs": {
    "ThreadList": {"type": "array", "items": {"$ref": "thread_v1.json"}},
    "ThreadDetail": {
      "type": "object", "required": ["thread", "messages", "runs"],
      "properties": {
        "thread": {"$ref": "thread_v1.json"}, "messages": {"type": "array", "items": {"$ref": "message_v1.json"}},
        "runs": {"type": "array", "items": {"type": "object", "required": ["run_id", "status", "created_at"], "properties": {
          "run_id": {"type": "string"}, "status": {"$ref": "run_v1.json#/$defs/RunStatus"}, "created_at": {"type": "string", "format": "date-time"}
        }, "additionalProperties": false}}
      }, "additionalProperties": false
    },
    "MessageRunResponse": {"type": "object", "required": ["message_id", "run_id", "task_id", "status"], "properties": {
      "message_id": {"type": "string"}, "run_id": {"type": "string"}, "task_id": {"type": "string"}, "status": {"$ref": "run_v1.json#/$defs/RunStatus"}
    }, "additionalProperties": false},
    "ArchiveResponse": {"type": "object", "required": ["thread_id", "archived"], "properties": {"thread_id": {"type": "string"}, "archived": {"const": true}}, "additionalProperties": false},
    "CancelResponse": {"type": "object", "required": ["run_id", "status"], "properties": {"run_id": {"type": "string"}, "status": {"$ref": "run_v1.json#/$defs/RunStatus"}}, "additionalProperties": false},
    "EventListResponse": {"type": "object", "required": ["events"], "properties": {"events": {"type": "array", "items": {"$ref": "run_event_v1.json"}}}, "additionalProperties": false},
    "DocumentListResponse": {"type": "object", "required": ["documents"], "properties": {"documents": {"type": "array", "items": {"$ref": "document_v1.json"}}}, "additionalProperties": false},
    "IndexResponse": {"type": "object", "required": ["task_id", "document_id", "state"], "properties": {"task_id": {"type": "string"}, "document_id": {"type": "string"}, "state": {"type": "string"}}, "additionalProperties": false},
    "HealthLive": {"type": "object", "required": ["status"], "properties": {"status": {"const": "ok"}}, "additionalProperties": false},
    "ErrorResponse": {"type": "object", "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}, "additionalProperties": false},
    "ValidationErrorResponse": {"type": "object", "required": ["detail"], "properties": {"detail": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["type", "loc", "msg"], "properties": {"type": {"type": "string", "minLength": 1}, "loc": {"type": "array", "minItems": 1, "items": {"type": ["string", "integer"]}}, "msg": {"const": "请求参数校验失败"}}, "additionalProperties": false}}}, "additionalProperties": false}
  }
}
