{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sesrag.local/contracts/api_responses_v2.json",
  "$defs": {
    "ThreadCreate": {
      "type": "object", "properties": {"title": {"type": "string", "pattern": "^\\s*\\S(?:[\\s\\S]{0,198}\\S)?\\s*$", "default": "新会话"}}, "additionalProperties": false
    },
    "ThreadPatch": {
      "type": "object", "minProperties": 1,
      "properties": {"title": {"type": "string", "pattern": "^\\s*\\S(?:[\\s\\S]{0,198}\\S)?\\s*$"}, "archived": {"type": "boolean"}}, "additionalProperties": false
    },
    "BranchCreate": {
      "type": "object", "required": ["parent_branch_id", "fork_message_id"],
      "properties": {
        "parent_branch_id": {"type": "string", "minLength": 1}, "fork_message_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "pattern": "^\\s*\\S(?:[\\s\\S]{0,78}\\S)?\\s*$"}
      }, "additionalProperties": false
    },
    "MessageCreate": {
      "type": "object", "required": ["branch_id", "content", "expected_version"],
      "properties": {
        "branch_id": {"type": "string", "minLength": 1}, "content": {"type": "string", "minLength": 1, "maxLength": 20000, "pattern": "\\S"},
        "expected_version": {"type": "integer", "minimum": 0},
        "model_profile_id": {"type": "string", "minLength": 1, "maxLength": 100}, "model_profile_version": {"type": "integer", "minimum": 1}
      },
      "dependentRequired": {"model_profile_id": ["model_profile_version"], "model_profile_version": ["model_profile_id"]}, "additionalProperties": false
    },
    "RunOperationCreate": {"$ref": "model_profile_v2.json#/$defs/ProfileSelectionRequest"},
    "ThreadListQuery": {
      "type": "object", "properties": {
        "include_archived": {"type": "boolean", "default": false}, "cursor": {"type": "string", "minLength": 1},
        "limit": {"type": "integer", "minimum": 1, "maximum": 200, "default": 50}
      }, "additionalProperties": false
    },
    "ThreadDetailQuery": {
      "type": "object", "properties": {
        "branch_id": {"type": "string", "minLength": 1}, "before_seq": {"type": "integer", "minimum": 1},
        "limit": {"type": "integer", "minimum": 1, "maximum": 200, "default": 50}
      }, "additionalProperties": false
    },
    "EventListQuery": {
      "type": "object", "properties": {
        "after_seq": {"type": "integer", "minimum": 0, "default": 0}, "limit": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 200}
      }, "additionalProperties": false
    },
    "ContextQuery": {"type": "object", "properties": {"generation": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "ThreadList": {
      "type": "object", "required": ["threads", "next_cursor", "has_more"],
      "properties": {"threads": {"type": "array", "maxItems": 200, "items": {"$ref": "thread_v2.json"}}, "next_cursor": {"type": ["string", "null"]}, "has_more": {"type": "boolean"}}, "additionalProperties": false
    },
    "ThreadDetail": {
      "type": "object", "required": ["thread", "branch", "branch_path", "messages", "runs", "active_run_id", "recent_run_id", "next_before_seq", "has_more"],
      "properties": {
        "thread": {"$ref": "thread_v2.json"}, "branch": {"$ref": "branch_v2.json"}, "branch_path": {"type": "array", "minItems": 1, "items": {"$ref": "branch_v2.json"}},
        "messages": {"type": "array", "maxItems": 200, "items": {"$ref": "message_v2.json"}}, "runs": {"type": "array", "items": {"$ref": "run_v2.json#/$defs/RunSummary"}},
        "active_run_id": {"type": ["string", "null"]}, "recent_run_id": {"type": ["string", "null"]},
        "next_before_seq": {"type": ["integer", "null"], "minimum": 1}, "has_more": {"type": "boolean"}
      }, "additionalProperties": false
    },
    "BranchListResponse": {"type": "object", "required": ["branches"], "properties": {"branches": {"type": "array", "items": {"$ref": "branch_v2.json"}}}, "additionalProperties": false},
    "MessageRunResponse": {
      "type": "object", "required": ["branch_id", "message_id", "run_id", "task_id", "status"],
      "properties": {"branch_id": {"type": "string", "minLength": 1}, "message_id": {"type": "string", "minLength": 1}, "run_id": {"type": "string", "minLength": 1}, "task_id": {"type": "string", "minLength": 1}, "status": {"$ref": "run_v2.json#/$defs/RunStatus"}}, "additionalProperties": false
    },
    "CancelResponse": {"type": "object", "required": ["run_id", "status"], "properties": {"run_id": {"type": "string", "minLength": 1}, "status": {"$ref": "run_v2.json#/$defs/RunStatus"}}, "additionalProperties": false},
    "EventListResponse": {
      "type": "object", "required": ["events", "next_after_seq", "has_more"],
      "properties": {"events": {"type": "array", "maxItems": 1000, "items": {"$ref": "run_event_v2.json"}}, "next_after_seq": {"type": "integer", "minimum": 0}, "has_more": {"type": "boolean"}}, "additionalProperties": false
    },
    "ModelListResponse": {
      "type": "object", "required": ["models", "default_profile"],
      "properties": {"models": {"type": "array", "items": {"$ref": "model_profile_v2.json"}}, "default_profile": {"$ref": "model_profile_v2.json#/$defs/ModelProfileKey"}}, "additionalProperties": false
    },
    "ContextResponse": {
      "oneOf": [
        {"type": "object", "required": ["plan", "reason"], "properties": {"plan": {"type": "null"}, "reason": {"const": "not_planned"}}, "additionalProperties": false},
        {"type": "object", "required": ["plan", "reason"], "properties": {"plan": {"$ref": "context_plan_v2.json"}, "reason": {"type": "null"}}, "additionalProperties": false}
      ]
    },
    "ErrorResponse": {"$ref": "api_responses_v1.json#/$defs/ErrorResponse"},
    "ValidationErrorResponse": {"$ref": "api_responses_v1.json#/$defs/ValidationErrorResponse"},
    "UnprocessableResponse": {"oneOf": [{"$ref": "api_responses_v1.json#/$defs/ErrorResponse"}, {"$ref": "api_responses_v1.json#/$defs/ValidationErrorResponse"}]}
  }
}
