{
  "$defs": {
    "EvidenceComponent": {
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "title": "Component Id",
          "type": "string"
        },
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "start_offset": {
          "title": "Start Offset",
          "type": "integer"
        },
        "end_offset": {
          "title": "End Offset",
          "type": "integer"
        },
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "component_id",
        "chunk_id",
        "start_offset",
        "end_offset",
        "content_hash"
      ],
      "title": "EvidenceComponent",
      "type": "object"
    },
    "Location": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "line",
            "paragraph",
            "table_cell",
            "page",
            "slide",
            "sheet_range",
            "block"
          ],
          "title": "Kind",
          "type": "string"
        },
        "origin": {
          "enum": [
            "source",
            "normalized"
          ],
          "title": "Origin",
          "type": "string"
        },
        "quality": {
          "enum": [
            "verified",
            "block_only"
          ],
          "title": "Quality",
          "type": "string"
        },
        "number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Number"
        },
        "end_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Number"
        },
        "block_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Id"
        },
        "sheet_name": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheet Name"
        },
        "cell_range": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell Range"
        },
        "table": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table"
        },
        "row": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row"
        },
        "column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        },
        "start_offset": {
          "minimum": 0,
          "title": "Start Offset",
          "type": "integer"
        },
        "end_offset": {
          "minimum": 0,
          "title": "End Offset",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "origin",
        "quality",
        "start_offset",
        "end_offset"
      ],
      "title": "Location",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "bundle_id": {
      "title": "Bundle Id",
      "type": "string"
    },
    "document_id": {
      "title": "Document Id",
      "type": "string"
    },
    "index_batch_id": {
      "title": "Index Batch Id",
      "type": "string"
    },
    "text": {
      "maxLength": 4000,
      "title": "Text",
      "type": "string"
    },
    "components": {
      "items": {
        "$ref": "#/$defs/EvidenceComponent"
      },
      "maxItems": 100,
      "title": "Components",
      "type": "array"
    },
    "locations": {
      "items": {
        "$ref": "#/$defs/Location"
      },
      "maxItems": 1000,
      "title": "Locations",
      "type": "array"
    },
    "dense_score": {
      "title": "Dense Score",
      "type": "number"
    },
    "rerank_score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rerank Score"
    },
    "next_offset": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Offset"
    }
  },
  "required": [
    "bundle_id",
    "document_id",
    "index_batch_id",
    "text",
    "components",
    "locations",
    "dense_score",
    "next_offset"
  ],
  "title": "EvidenceBundle",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sesrag.local/contracts/evidence_v2.json"
}
